# Copy to .env and fill in. All values are optional; the server falls back to
# server/data/*.json when Mongo is not configured.
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="shivnaresh"

# Google sign-in (or set these in /admin)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional explicit redirect; defaults to <origin>/api/auth/google/callback
GOOGLE_REDIRECT_URI=""

# imgbb — public image hosting for uploads
IMGBB_KEY=""
